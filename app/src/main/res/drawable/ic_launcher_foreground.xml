<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. 悬浮提词透镜外框 (Floating Prompter Slate Frame) -->
    <path
        android:pathData="M 28,26 L 80,26 A 10,10 0 0,1 90,36 L 90,74 A 10,10 0 0,1 80,84 L 28,84 A 10,10 0 0,1 18,74 L 18,36 A 10,10 0 0,1 28,26 Z"
        android:strokeColor="#38BDF8"
        android:strokeWidth="3.2"
        android:fillColor="#151E32" />

    <!-- 2. 悬浮窗顶部控制栏指示线 -->
    <path
        android:pathData="M 26,34 L 82,34"
        android:strokeColor="#3038BDF8"
        android:strokeWidth="1.5" />

    <!-- 3. 口播流光字幕横线 (Glowing Teleprompter Subtitle Lines) -->
    <!-- 顶行：微弱台词 -->
    <path
        android:pathData="M 28,42 L 54,42"
        android:strokeColor="#64748B"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- 中间行：高亮视线黄金焦点行 (Amber Highlight Focus Line) -->
    <path
        android:pathData="M 28,50 L 62,50"
        android:strokeColor="#FACC15"
        android:strokeWidth="3.2"
        android:strokeLineCap="round" />

    <!-- 底行：准备朗读行 -->
    <path
        android:pathData="M 28,58 L 50,58"
        android:strokeColor="#94A3B8"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- 4. 电容麦克风图标 (Studio Broadcast Condenser Mic) -->
    <!-- 麦克风网头 -->
    <path
        android:pathData="M 74,40 L 74,52 A 6,6 0 0,1 62,52 L 62,40 A 6,6 0 0,1 74,40 Z"
        android:fillColor="#6366F1" />

    <!-- 麦克风拾音弧形支架 -->
    <path
        android:pathData="M 58,48 C 58,58 78,58 78,48"
        android:strokeColor="#818CF8"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- 麦克风立柱与底座 -->
    <path
        android:pathData="M 68,58 L 68,66 M 61,66 L 75,66"
        android:strokeColor="#818CF8"
        android:strokeWidth="2.4"
        android:strokeLineCap="round" />

    <!-- 5. 录像进行中流光绿信标 (Live Recording Beacon) -->
    <path
        android:pathData="M 78,30 A 2.5,2.5 0 1,1 77.99,30 Z"
        android:fillColor="#10B981" />

</vector>
