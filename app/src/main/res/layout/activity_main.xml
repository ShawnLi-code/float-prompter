<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="180dp">

            <!-- 顶部 Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="🎙️"
                    android:textSize="22sp"
                    android:background="@drawable/badge_pill" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_main"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvVersionInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="v1.0.2 • 流光提词"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnCheckUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="🔄 检查更新"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="@drawable/badge_pill"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 卡片 1：台词稿输入与智能整理 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_rounded"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <!-- 顶部工具按钮条 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/btnPaste"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="📋 粘贴"
                        android:textColor="@color/text_main"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_secondary"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnSaveScript"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1.2"
                        android:gravity="center"
                        android:text="💾 保存稿件"
                        android:textColor="#38BDF8"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_secondary"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnScriptLibrary"
                        android:layout_width="0dp"
                        android:layout_height="38dp"
                        android:layout_weight="1.2"
                        android:gravity="center"
                        android:text="📚 历史稿件"
                        android:textColor="@color/accent_amber"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_secondary"
                        android:layout_marginEnd="6dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/btnClear"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:gravity="center"
                        android:text="🗑️"
                        android:textSize="14sp"
                        android:background="@drawable/btn_secondary"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- 台词文本编辑框（支持内部上下顺畅滑动） -->
                <EditText
                    android:id="@+id/etScriptInput"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:background="#0A0E17"
                    android:gravity="top|start"
                    android:hint="@string/hint_input_script"
                    android:textColor="@color/text_main"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:padding="12dp"
                    android:inputType="textMultiLine"
                    android:scrollbars="vertical"
                    android:overScrollMode="always"
                    android:isScrollContainer="true" />

                <!-- 字数与时长统计 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvWordCountStat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="统计：0 字 ｜ 预计 0 秒"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvFormatStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未排版"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 核心：一键智能整理大按钮 -->
                <TextView
                    android:id="@+id/btnAutoFormat"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:gravity="center"
                    android:text="⚡ 自动整句排版（一句话结束才换行，逗号不打碎）"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:background="@drawable/btn_primary"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- 过滤动作与载入示例辅助行 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <CheckBox
                        android:id="@+id/cbFilterStage"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="过滤动作（如：叹气、看镜头）"
                        android:textColor="@color/text_sub"
                        android:textSize="11sp"
                        android:checked="true" />

                    <TextView
                        android:id="@+id/btnLoadSample"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:paddingHorizontal="8dp"
                        android:text="✨ 试用《6个月法则》示例"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

            </LinearLayout>

            <!-- 卡片 2：悬浮窗运行设置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_rounded"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️ 悬浮窗滚屏设置"
                    android:textColor="@color/text_main"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <!-- 模式切换：匀速 vs 跟读 -->
                <RadioGroup
                    android:id="@+id/rgScrollMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbModeSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mode_speed"
                        android:textColor="@color/text_main"
                        android:textSize="13sp"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/rbModeVoice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/mode_voice"
                        android:textColor="@color/text_main"
                        android:textSize="13sp" />
                </RadioGroup>

                <!-- 语速滑块调节 -->
                <LinearLayout
                    android:id="@+id/layoutSpeedSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="默认滚屏语速档位"
                            android:textColor="@color/text_sub"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvSpeedDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 档 (正常语速)"
                            android:textColor="@color/accent_amber"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekBarSpeed"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:min="1"
                        android:max="10"
                        android:progress="4"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

                <!-- 默认透明度调节 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="默认窗口透明度"
                            android:textColor="@color/text_sub"
                            android:textSize="12sp" />
                        <TextView
                            android:id="@+id/tvOpacityDisplay"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="80%"
                            android:textColor="@color/primary_indigo_light"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seekBarOpacity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:min="20"
                        android:max="100"
                        android:progress="80"
                        android:layout_marginTop="6dp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 底部固定双层操作区域（布局清晰，告别文字换行折叠） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#F50B0F19"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:elevation="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/btnPermissionGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 OPPO/小米若未见小球，点此前往【系统权限】开启「悬浮窗」与「后台弹出」"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- 核心第一主按钮：开启提词并自动打开手机原厂相机 -->
        <TextView
            android:id="@+id/btnLaunchCamera"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="📸 开启提词并打开系统原配相机"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/btn_primary"
            android:clickable="true"
            android:focusable="true" />

        <!-- 辅助按钮行：仅开启悬浮球 + 退出关闭 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/btnStartFloat"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="💬 仅显示悬浮球"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_secondary"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/btnStopFloat"
                android:layout_width="90dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="✕ 关闭退出"
                android:textColor="@color/alert_rose"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/btn_secondary"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
